; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be changed rarely.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Angry Animals"
config/icon="res://icon.svg"
config/version="1.0"
run/main_scene="res://Scenes/Main/Main.tscn"
config/features=PackedStringArray("4.4", "C#")

[autoload]

GameManager="*res://Globals/GameManager.cs"
Globals="*res://Globals/Globals.cs"
PlayerProfile="*res://Globals/PlayerProfile.cs"
RageSystem="*res://Globals/RageSystem.cs"
SignalManager="*res://Globals/SignalManager.cs"
ScoreManager="*res://Globals/ScoreManager.cs"
FileManager="*res://Globals/FileManager.cs"
AudioManager="*res://Globals/AudioManager.cs"
AdsManager="*res://Globals/AdsManager.cs"
MonetizationManager="*res://Globals/MonetizationManager.cs"
ObjectPool="*res://Globals/ObjectPool.cs"
LevelGenerator="*res://Globals/LevelGenerator.cs"
DailyChallengeManager="*res://Globals/DailyChallengeManager.cs"
LeaderboardManager="*res://Globals/LeaderboardManager.cs"
NotificationManager="*res://Globals/NotificationManager.cs"
EffectsManager="*res://Script/EffectsManager.cs"
GameFeelManager="*res://Script/GameFeelManager.cs"
HapticFeedbackManager="*res://Script/HapticFeedbackManager.cs"
SpeechBubbleManager="*res://Script/SpeechBubbleManager.cs"

# Infrastructure Systems
AssetLoader="*res://Classes/AssetLoader.cs"
AssetRegistry="*res://Classes/AssetRegistry.cs"
SpriteSheetLoader="*res://Classes/SpriteSheetLoader.cs"
AssetValidationTool="*res://Classes/AssetValidationTool.cs"
AndroidBuildManager="*res://Classes/AndroidBuildManager.cs"
IosBuildManager="*res://Classes/IosBuildManager.cs"
DesktopBuildManager="*res://Classes/DesktopBuildManager.cs"
BuildValidator="*res://Classes/BuildValidator.cs"
PrivacyPolicyManager="*res://Classes/PrivacyPolicyManager.cs"
VersionInfo="*res://Classes/VersionInfo.cs"
StoreListingManager="*res://Classes/StoreListingManager.cs"
PerformanceMonitor="*res://Classes/PerformanceMonitor.cs"
MemoryLeakDetector="*res://Classes/MemoryLeakDetector.cs"
EnhancedAudioSystem="*res://Classes/EnhancedAudioSystem.cs"
GameFeelTuningSystem="*res://Classes/GameFeelTuningSystem.cs"
AnalyticsManager="*res://Classes/AnalyticsManager.cs"
CrashReporter="*res://Classes/CrashReporter.cs"
TestingFramework="*res://Classes/TestingFramework.cs"
DifficultyAnalyzer="*res://Classes/DifficultyAnalyzer.cs"
ReleaseNotesGenerator="*res://Classes/ReleaseNotesGenerator.cs"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[dotnet]

project/assembly_name="AngryAnimals"

[monetization]

admob/app_id=""
admob/banner_ad_unit_id=""
admob/interstitial_ad_unit_id=""
admob/rewarded_ad_unit_id=""
iap/ios_product_id="full_game_unlock"
iap/android_product_id="full_game_unlock"
